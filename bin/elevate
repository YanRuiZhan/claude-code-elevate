#!/usr/bin/env python3
"""elevate —— 通过桌面通知请求授权，经 pkexec 以 root 执行命令。

用法：
    elevate --intent "中文意图" [--timeout 120] [--dry-run] -- <命令...>

流程：
    1. 弹出常驻通知，标题显示意图，正文显示完整命令，带「允许」「拒绝」按钮；
    2. 允许 -> 调用 pkexec（系统会弹密码框）执行；
    3. 拒绝 / 关闭通知 / 超时 -> 什么都不执行（fail-closed）。

退出码：
    0            命令成功
    10           用户点了「拒绝」
    11           超时未响应或通知被关闭
    12           找不到 pkexec / 通知服务不可用
    其余         命令自身的退出码（126/127 通常表示 pkexec 认证失败）

环境变量：
    ELEVATE_APP_NAME   通知里显示的应用名（默认 Claude Code）
    ELEVATE_ICON       自定义图标：stock 图标名或图片路径
"""

import argparse
import html
import json
import os
import shlex
import subprocess
import sys
import time

from gi.repository import Gio, GLib

APP_NAME = os.environ.get("ELEVATE_APP_NAME", "Claude Code")
_LOGO = os.path.expanduser("~/.local/share/elevate/claude-logo.png")
ICON = os.environ.get("ELEVATE_ICON") or (
    _LOGO if os.path.exists(_LOGO) else "system-lock-screen"
)
BUS_NAME = "org.freedesktop.Notifications"
OBJ_PATH = "/org/freedesktop/Notifications"
IFACE = "org.freedesktop.Notifications"
LOG_PATH = os.path.expanduser("~/.local/share/elevate/requests.log")

EXIT_DENIED = 10
EXIT_TIMEOUT = 11
EXIT_NOPKEXEC = 12


def log(record):
    try:
        os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
        record["time"] = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        with open(LOG_PATH, "a", encoding="utf-8") as f:
            f.write(json.dumps(record, ensure_ascii=False) + "\n")
    except OSError:
        pass


def ensure_session_env():
    """从 SSH/非图形环境启动时，尽量补上会话总线地址。"""
    if not os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        bus_path = f"/run/user/{os.getuid()}/bus"
        if os.path.exists(bus_path):
            os.environ["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={bus_path}"


def notify_and_wait(intent, command, timeout):
    """弹出通知并等待用户选择，返回 (action, reason)。"""
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)

    # GNOME 的通知正文会被压成单行，标题不支持 markup；
    # 所以「意图放标题、命令放正文」是唯一稳妥的两行排法。
    summary = f"{APP_NAME} · {intent}"
    body = f"$ {html.escape(command, quote=False)}"
    actions = ["allow", "允许", "deny", "拒绝"]
    hints = {
        "urgency": GLib.Variant("y", 2),  # critical：常驻、不自动消失
        "category": GLib.Variant("s", "device"),
    }

    try:
        result = bus.call_sync(
            BUS_NAME,
            OBJ_PATH,
            IFACE,
            "Notify",
            GLib.Variant(
                "(susssasa{sv}i)",
                (APP_NAME, 0, ICON, summary, body, actions, hints, 0),
            ),
            GLib.VariantType("(u)"),
            Gio.DBusCallFlags.NONE,
            -1,
            None,
        )
    except GLib.Error as exc:
        print(f"[elevate] 无法发送桌面通知：{exc.message}", file=sys.stderr)
        print("[elevate] 当前可能不在图形会话中，请手动执行该命令。", file=sys.stderr)
        return "nobus", None

    notif_id = result.unpack()[0]
    loop = GLib.MainLoop()
    state = {"action": None, "reason": "timeout"}

    def on_signal(_conn, _sender, _path, _iface, signal, params):
        if signal == "ActionInvoked":
            nid, action = params.unpack()
            if nid == notif_id:
                state["action"] = action
                loop.quit()
        elif signal == "NotificationClosed":
            nid, _reason = params.unpack()
            if nid == notif_id:
                state["reason"] = "closed"
                loop.quit()

    sub = bus.signal_subscribe(
        BUS_NAME, IFACE, None, OBJ_PATH, None,
        Gio.DBusSignalFlags.NONE, on_signal,
    )
    GLib.timeout_add_seconds(timeout, loop.quit)
    loop.run()
    bus.signal_unsubscribe(sub)

    # 超时/关闭后把还挂着的通知收掉
    try:
        bus.call_sync(
            BUS_NAME, OBJ_PATH, IFACE, "CloseNotification",
            GLib.Variant("(u)", (notif_id,)),
            None, Gio.DBusCallFlags.NONE, -1, None,
        )
    except GLib.Error:
        pass

    return state["action"], state["reason"]


def main():
    parser = argparse.ArgumentParser(
        prog="elevate",
        description="弹出带「允许/拒绝」按钮的通知，批准后经 pkexec 以 root 执行命令。",
    )
    parser.add_argument("--intent", required=True,
                        help="这次提权的目的（会显示在通知标题里）")
    parser.add_argument("--timeout", type=int, default=120,
                        help="等待用户响应的秒数，超时视为拒绝（默认 120）")
    parser.add_argument("--dry-run", action="store_true",
                        help="只走通知授权流程，不真正执行命令（用于测试）")
    parser.add_argument("command", nargs=argparse.REMAINDER,
                        help="-- 之后是要以 root 执行的命令")
    args = parser.parse_args()

    cmd = list(args.command)
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    if not cmd:
        parser.error("缺少要执行的命令（放在 -- 之后）")
    if args.timeout < 5:
        parser.error("--timeout 至少要 5 秒")

    command = shlex.join(cmd)
    ensure_session_env()

    started = time.time()
    print(f"[elevate] 等待授权：{args.intent}", flush=True)
    action, reason = notify_and_wait(args.intent, command, args.timeout)
    waited = round(time.time() - started, 1)

    if action == "nobus":
        log({"intent": args.intent, "command": command,
             "decision": "no-session-bus"})
        return EXIT_NOPKEXEC

    if action != "allow":
        if action == "deny":
            message = "你点了「拒绝」，命令未执行"
            reason = "user"
        elif reason == "closed":
            message = "通知已关闭，视为拒绝，命令未执行"
        else:
            message = f"等待 {waited}s 无响应，视为拒绝，命令未执行"
        log({"intent": args.intent, "command": command,
             "decision": "deny", "reason": reason, "waited_s": waited})
        print(f"[elevate] {message}", file=sys.stderr)
        return EXIT_DENIED if action == "deny" else EXIT_TIMEOUT

    log({"intent": args.intent, "command": command,
         "decision": "allow", "waited_s": waited})

    if args.dry_run:
        print("[elevate] 已允许（dry-run，未执行命令）")
        return 0

    print("[elevate] 已允许，正在通过 pkexec 请求 root 认证……", flush=True)
    try:
        proc = subprocess.run(["pkexec", "/bin/bash", "-c", command])
    except FileNotFoundError:
        print("[elevate] 找不到 pkexec", file=sys.stderr)
        return EXIT_NOPKEXEC
    except KeyboardInterrupt:
        return 130

    rc = proc.returncode
    if rc in (126, 127):
        print(f"[elevate] root 认证失败或被取消（pkexec 退出码 {rc}）",
              file=sys.stderr)
    log({"intent": args.intent, "command": command,
         "decision": "executed", "exit_code": rc})
    return rc


if __name__ == "__main__":
    sys.exit(main())
